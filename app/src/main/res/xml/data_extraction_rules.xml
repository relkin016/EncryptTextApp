<?xml version="1.0" encoding="utf-8"?>
<!-- Сохранённые пароли зашифрованы ключом из Keystore, который не переносится:
     копировать их в облако или на другое устройство бессмысленно. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
